# Spotizan Backend Environment Configuration
NODE_ENV=development
PORT=5000

# Client Configuration
CLIENT_URL=http://localhost:5173

# Database Configuration (Default: local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/spotizan_dev

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Placeholder for subsequent phases
JWT_SECRET=your_development_jwt_secret_min_32_characters_long_here
COOKIE_SECRET=your_development_cookie_secret_key_here
